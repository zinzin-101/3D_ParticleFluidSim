#version 430 core
layout(local_size_x = 1) in;

layout(std430, binding = 12) buffer RadixHistograms { uint histograms[]; };

uniform uint numBlocks;

void main() {
    uint digitTotal[16];
    for (uint d = 0u; d < 16u; d++) {
        digitTotal[d] = 0u;
        for (uint b = 0u; b < numBlocks; b++) {
            digitTotal[d] += histograms[b * 16u + d];
        }
    }

    uint digitBase[16];
    uint running = 0u;
    for (uint d = 0u; d < 16u; d++) {
        digitBase[d] = running;
        running += digitTotal[d];
    }

    for (uint d = 0u; d < 16u; d++) {
        uint blockOffset = digitBase[d];
        for (uint b = 0u; b < numBlocks; b++) {
            uint count = histograms[b * 16u + d];
            histograms[b * 16u + d] = blockOffset;
            blockOffset += count;
        }
    }
}